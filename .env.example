# Produção: PostgreSQL externo, preferencialmente URL com pool e sslmode=verify-full.
DATABASE_URL=
# Somente desenvolvimento local. Nunca usar filesystem da Vercel como banco.
# Deixe vazio para usar AppData/Local/MegaG-Auditor/postgres no Windows, fora do OneDrive.
LOCAL_DATABASE_PATH=
ADMIN_EMAIL=admin@megag.local
# Gerar com pnpm run setup. Não publicar credenciais.
ADMIN_PASSWORD_HASH=
DATA_ENCRYPTION_KEY=
APP_ORIGIN=http://127.0.0.1:3000
